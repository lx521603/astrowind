---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: '联系我',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="联系我" title="获得联系方式" />

  <ContactUs
    id="form"
    title="现在给我发送信息"
    subtitle="回复快速, 翻阅常见问题。您或许能在这里找到所需的解决方案！如果找不到，我们的支持团队非常乐意为您提供帮助。"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: '称呼',
      },
      {
        type: 'email',
        name: 'email',
        label: '邮件地址',
      },
    ]}
    textarea={{
      label: '内容',
    }}
    disclaimer={{
      label:
        '提交此联系表格，即表示您确认并同意我们收集您的个人信息。',
    }}
    description="我会在最快时间回复你"
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="售前、售后咨询"
    items={[
      {
        title: '代理咨询',
        description: `有想代理产品，一起创业的小伙伴请联系我，线下教学、培训、陪跑。`,
      },
      {
        title: '购买咨询',
        description:
          '多地同城配送，快递包邮，抖音、淘宝多平台支持。',
      },
      {
        title: '售后支持',
        description:
          '支持未拆封 7 天无理由退货。免费换色号等。',
      },
      {
        title: '电话',
        description: '+1 (234) 567-890',
        icon: 'tabler:headset',
      },
      {
        title: '邮件',
        description: 'x@glee.ch',
        icon: 'tabler:mail',
      },
      {
        title: '地址',
        description: '落日集市, 新玩厂, 芒市, 云南',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
