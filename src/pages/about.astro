  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="✨我们的价值观"
    subtitle="在美丽的世界里，妆容不仅是外表，更是态度。我们相信每一笔粉底、每一抹唇色，都能承载自信与力量。"
    items={[
      {
        title: '以顾客为中心',
        description:
          '我们倾听每一位姐妹的心声，理解她们对美的渴望。无论是日常通勤的轻妆，还是舞台上的闪耀，我们都致力于提供贴心、实用又高品质的美妆产品，让你在任何场合都能展现最好的自己。',
      },
      {
        title: '不断创新与提升',
        description:
          '美丽从不止步。我们不断研发新配方，探索更轻盈、更持久、更环保的质地，让妆容既能满足潮流趋势，又能呵护肌肤健康。每一次升级，都是为了让你拥有更自在、更安心的美丽体验。',
      },
      {
        title: '坚守美丽与责任',
        description:
          '我们相信，美丽不应以牺牲为代价。坚持安全成分、拒绝动物实验、倡导环保包装，是我们对世界的承诺。美丽不仅属于个人，更是一种对社会和环境的责任。',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="我们的成就"
    subtitle="一路走来，我们不仅在产品上不断突破，更在美丽的世界里赢得了姐妹们的信赖与认可。"
    isReversed={true}
    callToAction={{
      text: '了解更多',
      href: '/',
    }}
    items={[
      {
        title: '🌍 美丽的全球触达',
        description: '从抖音到小红书，从夜市到海外电商，我们的美妆产品已经走向更广阔的舞台。无论你身处何地，都能轻松拥有属于自己的美丽。',
        icon: 'tabler:globe',
      },
      {
        title: '💖 姐妹们的好评与口碑',
        description:
          '真实的反馈是最好的奖杯。成千上万的姐妹在评论区分享她们的美丽故事，证明我们的产品不仅好用，更能带来自信与快乐',
        icon: 'tabler:message-star',
      },
      {
        title: '🏆 行业认可与荣誉',
        description:
          '我们坚持安全成分、创新配方和贴心体验，赢得了美妆行业的多项荣誉与认可。每一个奖项，都是对我们坚持初心的最好肯定。',
