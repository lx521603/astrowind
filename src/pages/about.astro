  <!-- Features2 Widget ************** -->

  <section class="my-12">
    <h2 class="text-2xl font-bold mb-4">售前售后咨询</h2>
    <p class="text-gray-600 mb-8">联系我们</p>

    <div class="grid grid-cols-2 gap-8">
      <div class="text-center">
        <h3 class="mb-2 font-semibold">微信</h3>
        <img src={qrcodeWechat} alt="微信二维码" class="w-40 h-40 mx-auto" />
      </div>

      <div class="text-center">
        <h3 class="mb-2 font-semibold">抖音</h3>
        <img src={qrcodeDy} alt="抖音二维码" class="w-40 h-40 mx-auto" />
      </div>
    </div>
  </section>
</Layout>
